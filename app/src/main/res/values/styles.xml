<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppThemeLight" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#1565C0</item>
        <item name="android:colorPrimary">#E3EAF2</item>
        <item name="android:colorBackground">#FAFAFA</item>
